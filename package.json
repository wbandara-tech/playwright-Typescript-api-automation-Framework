{
  "name": "playwright-api-automation-framework",
  "version": "1.0.0",
  "description": "Enterprise-grade Playwright API Automation Framework for restful-api.dev",
  "author": "Wasantha Bandara",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wbandara-tech/playwright-api-automation-framework"
  },
  "keywords": [
    "playwright",
    "api-testing",
    "automation",
    "typescript",
    "rest-api",
    "qa"
  ],
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --grep @api",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "allure": "allure generate --clean",
    "allure:open": "allure open allure-results",
    "allure:report": "allure generate allure-results -o allure-report --clean && allure open allure-report",
    "lint": "tsc --noEmit",
    "type-check": "tsc --skipLibCheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.5.4",
    "allure-commandline": "^2.28.0",
    "allure-playwright": "^2.14.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
